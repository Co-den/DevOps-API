# App
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Neon Postgres
# Use a Neon connection string (usually includes sslmode=require)
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Security
JWT_SECRET=replace-with-a-secure-secret
JWT_EXPIRES_IN=1d
ARCJET_API_KEY=replace-with-your-arcjet-key
